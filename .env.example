# Environment Variables Template
# Copy this file to .env.local and fill in your values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nextjs-starter
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For a private Tailscale admin in production, set this to your VPS MagicDNS host,
# for example: https://my-vps.my-tailnet.ts.net
ADMIN_APP_URL=http://admin.localhost:3000

# Logging
LOG_LEVEL=info

# API
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60000

# Intake / Admin Auth
INTAKE_UPLOAD_DIR=storage/intake
INTAKE_SESSION_SECRET=replace-with-a-long-random-secret
INTAKE_SHARE_LINK_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-secret
# Set this to false when Tailscale or another private network is the primary
# admin barrier and you do not want to maintain per-device IPs in the app.
ADMIN_ENFORCE_IP_ALLOWLIST=true
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Shared secret between the private Tailscale reverse proxy and the app when the
# admin host is tunneled through a local proxy into Coolify or Traefik.
ADMIN_PROXY_SHARED_SECRET=replace-with-a-long-random-secret
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Cloudflare Turnstile
# Optional but recommended for spam and bot protection on the contact form.
# Set both values together or leave both empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mail / SMTP
# Set these values to enable real email delivery from the contact form.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
CONTACT_FROM_EMAIL=no-reply@example.com
CONTACT_TO_EMAIL=no-reply@example.com
